{
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Jwt": {
    "Issuer": "ai-encyclopedia",
    "Audience": "ai-encyclopedia-users",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 30
  },

  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },

  "AI": {
    "DefaultProvider": "openai",
    "FallbackProvider": "claude",
    "MaxRetries": 2,
    "TimeoutSeconds": 120
  },

  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o",
    "MaxTokens": 4096,
    "Temperature": 0.7
  },

  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-opus-4-7",
    "MaxTokens": 4096,
    "ApiVersion": "2023-06-01"
  },

  "Google": {
    "GeminiApiKey": "",
    "GeminiModel": "gemini-1.5-pro"
  },

  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "ProPriceId": "",
    "EnterprisePriceId": ""
  },

  "HealthChecks": {
    "Enabled": true
  },

  "RateLimit": {
    "ApiPermitLimit": 100,
    "ApiWindowMinutes": 1,
    "AuthPermitLimit": 10,
    "AuthWindowMinutes": 1
  }
}
