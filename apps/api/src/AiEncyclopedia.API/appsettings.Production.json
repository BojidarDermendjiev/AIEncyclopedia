{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Error",
        "AiEncyclopedia": "Information"
      }
    }
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "AI": {
    "DefaultProvider": "openai",
    "FallbackProvider": "claude",
    "MaxRetries": 2,
    "TimeoutSeconds": 120
  },

  "OpenAI": {
    "Model": "gpt-4o",
    "MaxTokens": 4096,
    "Temperature": 0.7
  },

  "Anthropic": {
    "Model": "claude-opus-4-7",
    "MaxTokens": 4096,
    "ApiVersion": "2023-06-01"
  },

  "Google": {
    "GeminiModel": "gemini-1.5-pro"
  },

  "RateLimit": {
    "ApiPermitLimit": 100,
    "ApiWindowMinutes": 1,
    "AuthPermitLimit": 10,
    "AuthWindowMinutes": 1
  }
}
