{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },

  "Jwt": {
    "Issuer": "ai-encyclopedia-dev",
    "Audience": "ai-encyclopedia-users-dev",
    "Secret": "dev-secret-change-in-production-min-32-chars!",
    "ExpiryMinutes": 1440,
    "RefreshExpiryDays": 30
  },

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=encyclopedia;Username=app;Password=changeme;Include Error Detail=true",
    "Redis": "localhost:6379,abortConnect=false"
  },

  "AI": {
    "DefaultProvider": "openai",
    "FallbackProvider": "claude",
    "MaxRetries": 1,
    "TimeoutSeconds": 60
  },

  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "MaxTokens": 2048,
    "Temperature": 0.7
  },

  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-haiku-4-5-20251001",
    "MaxTokens": 2048,
    "ApiVersion": "2023-06-01"
  },

  "Google": {
    "GeminiApiKey": "",
    "GeminiModel": "gemini-1.5-flash"
  },

  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "ProPriceId": "",
    "EnterprisePriceId": ""
  },

  "RateLimit": {
    "ApiPermitLimit": 1000,
    "ApiWindowMinutes": 1,
    "AuthPermitLimit": 100,
    "AuthWindowMinutes": 1
  }
}
