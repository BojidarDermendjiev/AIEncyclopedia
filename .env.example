# ============================================================
# AI Encyclopedia Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- ASP.NET Core -----
ASPNETCORE_ENVIRONMENT=Development

# ----- Database -----
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=encyclopedia;Username=app;Password=changeme
ConnectionStrings__Redis=redis:6379,abortConnect=false

# ----- JWT -----
Jwt__Secret=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
Jwt__Issuer=ai-encyclopedia
Jwt__Audience=ai-encyclopedia-users
Jwt__ExpiryMinutes=60
Jwt__RefreshExpiryDays=30

# ----- AI Providers -----
# Options: openai | claude | gemini
AI__DefaultProvider=openai
AI__FallbackProvider=claude
AI__MaxRetries=2
AI__TimeoutSeconds=120

OpenAI__ApiKey=sk-...
OpenAI__Model=gpt-4o
OpenAI__MaxTokens=4096
OpenAI__Temperature=0.7

Anthropic__ApiKey=sk-ant-...
Anthropic__Model=claude-opus-4-7
Anthropic__MaxTokens=4096
Anthropic__ApiVersion=2023-06-01

Google__GeminiApiKey=AIza...
Google__GeminiModel=gemini-1.5-pro

# ----- Stripe -----
Stripe__SecretKey=sk_test_...
Stripe__WebhookSecret=whsec_...
Stripe__PublishableKey=pk_test_...
Stripe__ProPriceId=price_...
Stripe__EnterprisePriceId=price_...

# ----- n8n -----
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_WEBHOOK_URL=http://n8n:5678
N8N_HOST=n8n

# ----- Postgres (Docker service) -----
POSTGRES_DB=encyclopedia
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:5000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_APP_NAME=AI Encyclopedia

# ----- Traefik / Domain -----
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com
